# ==============================================================================
# LMSetjen DPD RI - Apache Security & SPA Configuration (.htaccess)
# Mengatasi Temuan Pentest S-02: Konfigurasi Keamanan Lingkungan (Django & React)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECURITY HEADERS (mod_headers) - Mengatasi S-02
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    # 1.1 Strict-Transport-Security (HSTS)
    # Memaksa browser hanya mengakses situs melalui HTTPS selama 1 tahun (termasuk subdomain)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # 1.2 X-Frame-Options
    # Mencegah serangan Clickjacking (iframe embedding)
    Header always set X-Frame-Options "SAMEORIGIN"

    # 1.3 X-Content-Type-Options
    # Mencegah browser melakukan MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"

    # 1.4 Referrer-Policy
    # Mengontrol informasi referrer yang dikirim saat navigasi
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # 1.5 Permissions-Policy
    # Membatasi akses browser API yang sensitif jika tidak diperlukan
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # 1.6 X-XSS-Protection
    # Mengaktifkan filter XSS bawaan browser lama
    Header always set X-XSS-Protection "1; mode=block"

    # 1.7 Content-Security-Policy (CSP)
    # Membatasi sumber daya (scripts, styles, images, media, connects) yang diizinkan untuk dieksekusi
    Header always set Content-Security-Policy "\
default-src 'self'; \
script-src 'self' 'unsafe-inline' 'unsafe-eval' https://accounts.google.com https://apis.google.com https://www.google.com https://www.gstatic.com; \
style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; \
font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; \
img-src 'self' data: blob: https: http:; \
media-src 'self' blob: https: http:; \
connect-src 'self' https: http: wss: ws:; \
frame-src 'self' https://accounts.google.com https://www.youtube.com https://www.youtube-nocookie.com https://drive.google.com; \
object-src 'none'; \
base-uri 'self'; \
form-action 'self';"
</IfModule>

# ------------------------------------------------------------------------------
# 2. DISABLE DIRECTORY BROWSING & SENSITIVE FILES ACCESS
# ------------------------------------------------------------------------------
# Mencegah penyerang melihat isi direktori file publik jika index tidak ditemukan
Options -Indexes

# Blokir akses langsung ke file sensitif atau file tersembunyi (misal .env, .git, .htaccess)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 3. HTTPS REDIRECT & REACT SPA CLIENT-SIDE ROUTING (mod_rewrite)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 3.1 Paksa Penggunaan HTTPS di Lingkungan Produksi
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 3.2 SPA Client-Side Routing: Arahkan semua request non-file ke index.html
    # Jika request bukan berupa file nyata (-f) atau direktori nyata (-d),
    # teruskan ke index.html agar React Router dapat menangani routing di sisi klien.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# 4. CACHE CONTROL & OPTIMIZATION (mod_expires / mod_headers)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Jangan cache file index.html agar user selalu mendapatkan versi bundle terbaru
    <Files "index.html">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </Files>

    # Cache asset statis Vite (JS, CSS, fonts, images di folder assets)
    <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|webp|ico)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
</IfModule>
